--- !u!114 &144043724
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 144043722}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a591f547ebb2a964493db0ba7969b0a1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - text: "\u7B2C1\u7AE0\u3000\u5F15\u3063\u8D8A\u3057\u306E\u65E5\r\n\r\n\u6BB5\u30DC\u30FC\u30EB\u306E\u5C71\u306B\u56F2\u307E\u308C\u305F\u90E8\u5C4B\u306E\u771F\u3093\u4E2D\u3067\u3001\u50D5\u306F\u305F\u3081\u606F\u3092\u3064\u3044\u305F\u3002\r\n\u300C\u2026\u2026\u601D\u3063\u305F\u3088\u308A\u72ED\u3044\u306A\u3002\u3067\u3082\u3001\u307E\u3042\u3001\u3072\u3068\u308A\u306A\u3089\u5341\u5206\u304B\u3002\u300D\r\n\r\n\u7A93\u306E\u5916\u304B\u3089\u3001\u77E5\u3089\u306A\u3044\u8857\u306E\u97F3\u304C\u3059\u308B\u3002\u8ECA\u306E\u30A8\u30F3\u30B8\u30F3\u3001\u5B50\u3069\u3082\u306E\u7B11\u3044\u58F0\u3001\u3069\u3053\u304B\u9060\u304F\u306E\u72AC\u306E\u9CF4\u304D\u58F0\u3002\r\n\u3053\u306E\u97F3\u305F\u3061\u304C\u3001\u3053\u308C\u304B\u3089\u50D5\u306E\u66AE\u3089\u3057\u306EBGM\u306B\u306A\u308B\u3093\u3060\u3068\u601D\u3046\u3068\u3001\u5C11\u3057\u3060\u3051\u5FC3\u7D30\u304F\u306A\u3063\u305F\u3002\r\n\r\n\u30B9\u30DE\u30DB\u304C\u9707\u3048\u308B\u3002\u6BCD\u304B\u3089\u306E\u7740\u4FE1\u3060\u3063\u305F\u3002\r\n\u300C\u3061\u3083\u3093\u3068\u98DF\u3079\u3066\u308B\uFF1F\u3000\u7121\u7406\u3057\u3066\u306A\u3044\uFF1F\u300D\r\n\u300C\u307E\u3060\u5F15\u3063\u8D8A\u3057\u305F\u3070\u3063\u304B\u308A\u3060\u3088\u3002\u5927\u4E08\u592B\u3002\u5FC3\u914D\u3057\u3059\u304E\u3002\u300D\r\n\u58F0\u3092\u805E\u3044\u305F\u77AC\u9593\u3001\u6025\u306B\u3053\u306E\u90E8\u5C4B\u304C\u201C\u7A7A\u3063\u307D\u201D\u306B\u611F\u3058\u305F\u3002"
    speaker: 
  - text: "\u7B2C2\u7AE0\u3000\u96A3\u4EBA\u3068\u306E\u51FA\u4F1A\u3044\r\n\r\n\u591C\u3001\u6BB5\u30DC\u30FC\u30EB\u3092\u7247\u4ED8\u3051\u3066\u3044\u308B\u3068\u3001\u30B3\u30F3\u30B3\u30F3\u3068\u30C9\u30A2\u304C\u9CF4\u3063\u305F\u3002\r\n\u300C\u3059\u307F\u307E\u305B\u3093\u3001\u96A3\u306E\u4F50\u85E4\u3067\u3059\u3002\u591C\u5206\u306B\u7533\u3057\u8A33\u306A\u3044\u3051\u3069\u3001\u5C11\u3057\u7269\u97F3\u304C\u6C17\u306B\u306A\u3063\u3066\u2026\u2026\u3002\u300D\r\n\r\n\u300C\u3042\u3063\u3001\u3059\u307F\u307E\u305B\u3093\uFF01\u3000\u5F15\u3063\u8D8A\u3057\u305F\u3070\u304B\u308A\u3067\u3001\u307E\u3060\u6574\u7406\u4E2D\u3067\u3002\u6C17\u3092\u3064\u3051\u307E\u3059\u3002\u300D\r\n\u5E74\u914D\u306E\u7537\u6027\u306F\u7B11\u3063\u3066\u300C\u82E5\u3044\u306E\u306B\u5049\u3044\u306D\u300D\u3068\u8A00\u3063\u3066\u5E30\u3063\u3066\u3044\u3063\u305F\u3002\r\n\r\n\u30C9\u30A2\u304C\u9589\u307E\u308B\u97F3\u304C\u3057\u3066\u3001\u90E8\u5C4B\u306B\u307E\u305F\u9759\u3051\u3055\u304C\u623B\u308B\u3002\r\n\u77E5\u3089\u306A\u3044\u4EBA\u306E\u512A\u3057\u3055\u306B\u3001\u80F8\u304C\u5C11\u3057\u3042\u305F\u305F\u304B\u304F\u306A\u3063\u305F\u3002"
    speaker: 
  - text: "\u7B2C3\u7AE0\u3000\u5B64\u72EC\u306E\u591C\r\n\r\n\u4ED5\u4E8B\u304B\u3089\u5E30\u3063\u3066\u3001\u30B3\u30F3\u30D3\u30CB\u5F01\u5F53\u3092\u673A\u306B\u7F6E\u304F\u3002\r\n\u30C6\u30EC\u30D3\u3082\u3064\u3051\u305A\u3001\u9ED9\u3005\u3068\u98DF\u3079\u308B\u3002\r\n\u300C\u2026\u2026\u307E\u305F\u540C\u3058\u5473\u304B\u3002\u300D\r\n\r\n\u6D17\u3063\u3066\u3044\u306A\u3044\u76BF\u3001\u958B\u3051\u3063\u653E\u3057\u306E\u30AB\u30FC\u30C6\u30F3\u3002\r\n\u90E8\u5C4B\u304C\u72ED\u304F\u611F\u3058\u308B\u306E\u306F\u3001\u5BB6\u5177\u306E\u305B\u3044\u3058\u3083\u306A\u3044\u3002\r\n\u201C\u3053\u306E\u90E8\u5C4B\u306B\u50D5\u3057\u304B\u3044\u306A\u3044\u201D\u3068\u3044\u3046\u73FE\u5B9F\u304C\u3001\u3069\u3093\u3069\u3093\u91CD\u304F\u306A\u3063\u3066\u3044\u304F\u3002"
    speaker: 
  - text: "\u7B2C4\u7AE0\u3000\u5BB6\u65CF\u304B\u3089\u306E\u96FB\u8A71\r\n\r\n\u6570\u9031\u9593\u3076\u308A\u306B\u6BCD\u304B\u3089\u96FB\u8A71\u304C\u304B\u304B\u3063\u3066\u304D\u305F\u3002\r\n\u300C\u304A\u3058\u3044\u3061\u3083\u3093\u3001\u8DB3\u304C\u60AA\u304F\u306A\u3063\u3066\u306D\u3002\u968E\u6BB5\u304C\u3064\u3089\u3044\u307F\u305F\u3044\u306A\u306E\u3002\u300D\r\n\u300C\u305D\u3063\u304B\u2026\u2026\u3002\u624B\u4F1D\u3044\u306B\u884C\u3051\u306A\u304F\u3066\u3001\u3054\u3081\u3093\u3002\u300D\r\n\r\n\u96FB\u8A71\u3092\u5207\u3063\u305F\u3042\u3068\u3001\u90E8\u5C4B\u306E\u5929\u4E95\u3092\u898B\u4E0A\u3052\u308B\u3002\r\n\u3053\u306E\u5C0F\u3055\u306A\u30A2\u30D1\u30FC\u30C8\u306F\u3001\u50D5\u306B\u81EA\u7531\u3092\u304F\u308C\u305F\u3051\u308C\u3069\u3001\r\n\u540C\u6642\u306B\u3001\u5BB6\u65CF\u306E\u5302\u3044\u3092\u5168\u90E8\u7F6E\u304D\u53BB\u308A\u306B\u3057\u3066\u304D\u305F\u5834\u6240\u3067\u3082\u3042\u3063\u305F\u3002"
    speaker: 
  - text: "\u7B2C5\u7AE0\u3000\u90E8\u5C4B\u306E\u7570\u5909\r\n\r\n\u3042\u308B\u671D\u3001\u5E8A\u306B\u5C0F\u3055\u306A\u6C34\u305F\u307E\u308A\u304C\u3067\u304D\u3066\u3044\u305F\u3002\r\n\u300C\u2026\u2026\u3048\uFF1F\u3000\u307E\u3055\u304B\u6C34\u6F0F\u308C\uFF1F\u300D\r\n\u30D0\u30B1\u30C4\u3092\u7F6E\u304D\u3001\u30BF\u30AA\u30EB\u3067\u62ED\u3044\u3066\u3082\u3001\u7FCC\u65E5\u306B\u306F\u307E\u305F\u6FE1\u308C\u3066\u3044\u308B\u3002\r\n\r\n\u653E\u7F6E\u3057\u3066\u3044\u305F\u73FE\u5B9F\u304C\u3001\u5F62\u3092\u5909\u3048\u3066\u8FEB\u3063\u3066\u304F\u308B\u3088\u3046\u3060\u3063\u305F\u3002\r\n\u300C\u4FFA\u3001\u4F55\u3057\u3066\u308B\u3093\u3060\u308D\u3046\u306A\u3002\u90E8\u5C4B\u3082\u3001\u5FC3\u3082\u3001\u30DC\u30ED\u30DC\u30ED\u3060\u3002\u300D"
    speaker: 
  - text: "\u7B2C6\u7AE0\u3000\u52A9\u3051\u5408\u3044\r\n\r\n\u96A3\u306E\u4F50\u85E4\u3055\u3093\u304C\u58F0\u3092\u304B\u3051\u3066\u304F\u308C\u305F\u3002\r\n\u300C\u56F0\u3063\u3066\u308B\u3068\u304D\u306F\u8A00\u3044\u306A\u3055\u3044\u3002\u3053\u3046\u3044\u3046\u306E\u306F\u4E8C\u4EBA\u3067\u3084\u308B\u3068\u65E9\u3044\u3088\u3002\u300D\r\n\u4E00\u7DD2\u306B\u30D0\u30B1\u30C4\u3092\u6301\u3061\u3001\u4FEE\u7406\u3092\u624B\u4F1D\u3063\u3066\u304F\u308C\u308B\u3002\r\n\r\n\u300C\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002\u2026\u2026\u306A\u3093\u304B\u3001\u4E45\u3057\u3076\u308A\u306B\u4EBA\u3068\u8A71\u3057\u307E\u3057\u305F\u3002\u300D\r\n\u7B11\u3063\u305F\u77AC\u9593\u3001\u90E8\u5C4B\u306E\u7A7A\u6C17\u304C\u5C11\u3057\u3060\u3051\u660E\u308B\u304F\u306A\u3063\u305F\u6C17\u304C\u3057\u305F\u3002\r\n\u4EBA\u306B\u983C\u308B\u3053\u3068\u306F\u3001\u8CA0\u3051\u308B\u3053\u3068\u3058\u3083\u306A\u3044\u3093\u3060\u3002"
    speaker: 
  - text: "\u7B2C7\u7AE0\u3000\u5E30\u7701\r\n\r\n\u4E45\u3057\u3076\u308A\u306B\u5B9F\u5BB6\u3078\u5E30\u308B\u3068\u3001\u6BCD\u304C\u53F0\u6240\u304B\u3089\u9854\u3092\u51FA\u3057\u305F\u3002\r\n\u300C\u3084\u305B\u305F\u306D\u3002\u3067\u3082\u3001\u9854\u306F\u5143\u6C17\u305D\u3046\u3002\u300D\r\n\u7236\u306F\u65B0\u805E\u3092\u7F6E\u304D\u3001\u9759\u304B\u306B\u8A00\u3063\u305F\u3002\r\n\u300C\u304A\u524D\u3001\u3088\u304F\u9811\u5F35\u3063\u3066\u308B\u306A\u3002\u300D\r\n\r\n\u300C\u2026\u2026\u5BB6\u306E\u3053\u3068\u3001\u9003\u3052\u3066\u305F\u3002\u3067\u3082\u3001\u3061\u3083\u3093\u3068\u5411\u304D\u5408\u3044\u305F\u3044\u3063\u3066\u601D\u3063\u305F\u3002\u300D\r\n\u6BCD\u306F\u3046\u306A\u305A\u304D\u306A\u304C\u3089\u5FAE\u7B11\u3093\u3060\u3002\r\n\u300C\u5BB6\u3063\u3066\u3001\u9003\u3052\u3066\u3082\u623B\u3063\u3066\u304D\u305F\u304F\u306A\u308B\u3082\u3093\u3088\u3002\u300D"
    speaker: 
  - text: "\u7B2C8\u7AE0\u3000\u6574\u7406\u306E\u65E5\r\n\r\n\u30A2\u30D1\u30FC\u30C8\u306B\u623B\u3063\u305F\u50D5\u306F\u3001\u307E\u305A\u6383\u9664\u3092\u59CB\u3081\u305F\u3002\r\n\u7A93\u3092\u958B\u3051\u308B\u3068\u3001\u51B7\u305F\u3044\u98A8\u3068\u3068\u3082\u306B\u5916\u306E\u97F3\u304C\u5165\u3063\u3066\u304F\u308B\u3002\r\n\u300C\u3053\u3053\u304C\u3001\u4FFA\u306E\u5BB6\u3060\u3002\u300D\r\n\r\n\u5BB6\u5177\u306E\u4F4D\u7F6E\u3092\u5909\u3048\u3001\u690D\u7269\u3092\u3072\u3068\u3064\u7F6E\u3044\u305F\u3002\r\n\u524D\u3088\u308A\u3082\u3001\u3053\u306E\u90E8\u5C4B\u304C\u201C\u547C\u5438\u201D\u3057\u3066\u3044\u308B\u3088\u3046\u306B\u611F\u3058\u305F\u3002"
    speaker: 
  - text: "\u7B2C9\u7AE0\u3000\u3042\u305F\u305F\u304B\u306A\u97F3\r\n\r\n\u6BCD\u304B\u3089\u30E1\u30C3\u30BB\u30FC\u30B8\u304C\u5C4A\u304F\u3002\r\n\u300C\u6B21\u306E\u4F11\u307F\u3001\u5E30\u3063\u3066\u304F\u308B\uFF1F\u300D\r\n\u300C\u3046\u3093\u3002\u4ECA\u5EA6\u306F\u4FFA\u304C\u3054\u98EF\u4F5C\u308B\u3088\u3002\u300D\r\n\r\n\u30B9\u30DE\u30DB\u3092\u7F6E\u304F\u3068\u3001\u30A2\u30D1\u30FC\u30C8\u306E\u5916\u304B\u3089\u7B11\u3044\u58F0\u304C\u805E\u3053\u3048\u305F\u3002\r\n\u3053\u306E\u90E8\u5C4B\u306E\u97F3\u304C\u3001\u524D\u3088\u308A\u3082\u3084\u3055\u3057\u304F\u97FF\u304F\u3002\r\n\u3082\u3046\u5B64\u72EC\u3058\u3083\u306A\u3044\u3002\r\n\u5BB6\u306F\u3001\u5F62\u3058\u3083\u306A\u304F\u3066\u3001\u5FC3\u306E\u4E2D\u306B\u3042\u308B\u3093\u3060\u3002"
    speaker: 
  - text: "\u30A8\u30F3\u30C7\u30A3\u30F3\u30B0\u30E1\u30C3\u30BB\u30FC\u30B8\r\n\r\n\u300C\u4EBA\u3068\u306E\u8DDD\u96E2\u3092\u6016\u304C\u308B\u305F\u3073\u306B\u3001\u50D5\u306F\u201C\u58C1\u201D\u3092\u4F5C\u3063\u3066\u3044\u305F\u3002\r\n\u3067\u3082\u3001\u672C\u5F53\u306E\u201C\u5BB6\u201D\u306F\u3001\u8AB0\u304B\u3068\u5FC3\u3092\u901A\u308F\u305B\u308B\u3053\u3068\u3067\u5C11\u3057\u305A\u3064\u5E83\u304C\u3063\u3066\u3044\u304F\u3082\u306E\u306A\u3093\u3060\u3002\u300D"
    speaker: 
  speakerText: {fileID: 1466198862}
  dialogueText: {fileID: 82884730}
  dialogueCanvas: {fileID: 104146596}
  textSpeed: 0.02
